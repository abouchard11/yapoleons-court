# Yapoleon's Court — environment template.
# Copy to .env.local for local dev; set the same names in the Vercel dashboard
# (Project -> Settings -> Environment Variables). NEVER commit real values —
# .env / .env.* are gitignored (only this .env.example is tracked).

# Gemini API key (server-only — NO VITE_ prefix). Consumed by the /api/court-judge
# serverless proxy (Plan 01-02); never bundled into client JS. Reuse yapword's key
# or mint a new one. Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (no-PII anon identity + replay-lock tables). Server-only — NEVER VITE_.
# From a NEW Supabase project: Settings -> API -> Project URL + service_role secret.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Non-TTY `supabase db push` (Account -> Access Tokens). Local CLI only, never in Vercel.
SUPABASE_ACCESS_TOKEN=your_supabase_access_token

# GA4 measurement ID (client-side, VITE_ prefix required).
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# PostHog product analytics (client-side, VITE_ prefix required).
VITE_POSTHOG_KEY=phc_your_posthog_api_key
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Gemini outage / quality alerts (optional locally; set in Vercel production).
ALERT_WEBHOOK_URL=your_apps_script_alert_relay_exec_url
ALERT_SECRET=your_alert_relay_secret
ALERT_TO=problem@yapoleon.com

# Vercel Cron secret for the keepalive / judge-warmup crons.
# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret

# ── Phase 4 (Safe, Capped & Measured) ──────────────────────────────────────────
# SAFE-02 input moderation (Plan 04-02): the red-lines pre-filter (detectRedLines in
# api/_sanitize.js) is fully DETERMINISTIC and in-repo — it needs NO new env var and
# NO new secret. Nothing to configure here for SAFE-02.
#
# COST-04 force-degrade (Plan 04-03, not yet wired here): a later wave adds a manual
# DEGRADE_MODE server flag (serve a cached in-voice reaction with zero model calls
# under load). It is documented here as the forthcoming toggle; leave it UNSET until
# 04-03 lands it.
#   DEGRADE_MODE=0   # (04-03) set to 1 to force the cached-reaction degrade path
