# Yapoleon's Court — environment template.
# Copy to .env.local for local dev; set the same names in the Vercel dashboard
# (Project -> Settings -> Environment Variables). NEVER commit real values —
# .env / .env.* are gitignored (only this .env.example is tracked).

# Gemini API key (server-only — NO VITE_ prefix). Consumed by the /api/court-judge
# serverless proxy (Plan 01-02); never bundled into client JS. Reuse yapword's key
# or mint a new one. Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (no-PII anon identity + replay-lock tables). Server-only — NEVER VITE_.
# From a NEW Supabase project: Settings -> API -> Project URL + service_role secret.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Non-TTY `supabase db push` (Account -> Access Tokens). Local CLI only, never in Vercel.
SUPABASE_ACCESS_TOKEN=your_supabase_access_token

# GA4 measurement ID (client-side, VITE_ prefix required).
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# PostHog product analytics (client-side, VITE_ prefix required).
VITE_POSTHOG_KEY=phc_your_posthog_api_key
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Gemini outage / quality alerts (optional locally; set in Vercel production).
ALERT_WEBHOOK_URL=your_apps_script_alert_relay_exec_url
ALERT_SECRET=your_alert_relay_secret
ALERT_TO=problem@yapoleon.com

# Vercel Cron secret for the keepalive / judge-warmup crons.
# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret

# ── Phase 4 (Safe, Capped & Measured) ──────────────────────────────────────────
# SAFE-02 input moderation (Plan 04-02): the red-lines pre-filter (detectRedLines in
# api/_sanitize.js) is fully DETERMINISTIC and in-repo — it needs NO new env var and
# NO new secret. Nothing to configure here for SAFE-02.
#
# COST-04 force-degrade (Plan 04-03) — the LIVE degradation path (D-09/D-10).
# The judge (api/court-judge.js) serves a CACHED in-voice reaction with ZERO model
# calls when degrading — a cheaper, still-playable round under load. favorDelta is
# still server-derived from neutral scores (the HARD INVARIANT holds).
#
#   DEGRADE_MODE=0   # set to 1 to FORCE the cached-reaction degrade path (manual lever).
#                    # Read at request time — a Vercel env change takes effect immediately.
#
#   MAX_CONCURRENT_JUDGE=40   # app-level concurrency damper (best-effort, single-instance).
#                             # Over this many in-flight judge requests on one warm instance,
#                             # a request takes the SAME cached-reaction path (0 model calls).
#                             # Default 40 if unset. Vercel Fluid Compute has NO native
#                             # per-project concurrency dial, so this is the in-process backstop.
#
# ── Vercel Spend Management (the ACCOUNT-LEVEL hard stop — the real kill switch) ──
# The app-level damper above is best-effort (per-instance). The DURABLE backstop is
# Vercel Spend Management (Dashboard -> Settings -> Billing -> Spend Management):
#   * Set a $ threshold. Vercel notifies at 50% / 75% / 100% of it.
#   * At 100% it can PAUSE production deployments (visitors get 503 DEPLOYMENT_PAUSED)
#     or fire a webhook. This is the account-level cost cap that stops a denial-of-wallet
#     spike the in-process counter cannot fully contain.
#   * RECOMMENDED M1 threshold: ~$50/month (see docs/economics/per-dau-cost-ledger.md §5
#     for the rationale — well above the projected M1 spend, low enough to catch a runaway).
#   * NOTE: Vercel checks spend every few minutes, so some overspend accrues past the line;
#     it is a hard stop, not a hair-trigger. Configure it in the dashboard (not a repo env var).
#
# VAL-04 client turn cap (Plan 04-04) — the reactive re-cal flag (D-14). The CLIENT-side
# 3-turn cap (src/config.ts MAX_TURNS, consumed by src/round.ts) is a config value so a
# future turn-count re-cal flips a flag, not a code edit. The VALUE STAYS 3 for Milestone 1
# (the turn-count gut-check kept 3 as a tracked hypothesis — no pre-launch 4-cap re-cal).
# The SERVER caps (api/court-record-round.js, api/court-judge.js) stay HARDCODED safety
# clamps and are NOT driven by this — the client is the tunable, the server clamps.
#
#   VITE_MAX_TURNS=3   # client turn cap. Leave 3 for M1; only a reactive re-cal changes it.
#                      # Absent/invalid → defaults to 3 (Number(undefined) || 3 === 3).
